{
  "name": "fogo",
  "version": "1.0.0",
  "description": "Yet another node.js framework, but simpler.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node test/package-smoke.mjs",
    "check:package": "publint && attw --pack .",
    "prepack": "npm run build",
    "release": "semantic-release",
    "check": "biome check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cezarsmpio/fogo.git"
  },
  "keywords": [
    "nodejs",
    "framework",
    "web",
    "http",
    "net",
    "rest",
    "node",
    "library",
    "restful",
    "typescript"
  ],
  "author": "Cezar Sampaio",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cezarsmpio/fogo/issues"
  },
  "homepage": "https://github.com/cezarsmpio/fogo#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.7",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
